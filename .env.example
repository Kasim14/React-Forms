# ------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# Never commit real values. On Vercel, set these in
# Project Settings → Environment Variables.
#
# IMPORTANT: none of these use the VITE_ prefix. Any variable that
# starts with VITE_ is bundled into the browser JavaScript and is
# visible to anyone. These are server-only (read inside /api).
# ------------------------------------------------------------------

# ---- Google Sheets (configured in Phase 5) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# ---- Authentication (configured in Phase 6) ----
# Long random string used to sign login sessions
JWT_SECRET=
# JSON list of admin users with bcrypt password hashes (multiple employees supported)
ADMIN_USERS=